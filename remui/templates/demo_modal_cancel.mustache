{{!

    @template theme_remui/demo_modal_cancel

    Custom modal template for the demo floating button modal.
    Extends core/modal with a capsule navigation header.

}}
{{< core/modal }}
    {{$header}}
        <h5 id="{{uniqid}}-modal-title" class="modal-title visually-hidden" data-region="title">Demo</h5>
        <div class="demo-modal-capsule-nav-wrapper">
            <nav class="demo-modal-capsule-nav">
                <a href="#" class="capsule active" data-tab="pagebuilder">
                    Page Builder Templates
                    <span class="pro-badge">PRO</span>
                </a>
                <a href="#" class="capsule" data-tab="homepages">Home pages</a>
                <a href="#" class="capsule" data-tab="layouts">Other layouts</a>
                <a href="#" class="capsule" data-tab="presets">Theme Presets</a>
            </nav>
        </div>
    {{/header}}
    {{$footer}}
        <button type="button" class="btn btn-secondary" data-action="cancel">{{#str}} cancel {{/str}}</button>
    {{/footer}}
{{/ core/modal }}
