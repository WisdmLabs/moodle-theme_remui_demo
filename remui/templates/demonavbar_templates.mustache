{{#js}}
require(['jquery'], function($) {
    $(document).ready(function() {
        function openDemoTab(tabId) {
            $('.demo-navbar-templates .tab-pane').removeClass('show active');
            $('.demo-navbar-templates .btn-tab').removeClass('active');
            $('.demo-navbar-templates .btn-tab').attr('aria-selected', false);

            $('#demo-' + tabId).addClass('show active');
            $('.demo-navbar-templates button[data-target="#demo-' + tabId + '"]').addClass('active');
            $('.demo-navbar-templates button[data-target="#demo-' + tabId + '"]').attr('aria-selected', true);
        }

        $(".demo-navbar-templates .buttons-wrapper .btn-tab").on("click", function() {
            let currentId = $(this).data('target').replace('#demo-', '');
            openDemoTab(currentId);
        });
    });
});
{{/js}}
