{{!

    @template theme_remui/demo_pagebuilder_templates_modal

    Modal body wrapper for the demo floating button modal.
    Renders tab panes for each capsule nav tab.

}}
<div class="d-flex flex-column modal-body-wrapper h-100 demo-modal-body-wrapper">
    {{#tabs}}
    <div class="demo-tab-pane {{^active}}d-none{{/active}}" data-tab-pane="{{key}}">
        {{> theme_remui/demo_modal_tab_content }}
    </div>
    {{/tabs}}
</div>
