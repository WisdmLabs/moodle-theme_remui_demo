{{!

    @template theme_remui/demo_modal_tab_content

    Common tab content partial for the demo modal.
    Expects context: sections (array of section objects with title and cards).

}}
{{#sections}}
<div class="demo-modal-section">
    <h6 class="demo-modal-section-title">{{title}}</h6>
    <div class="demo-modal-cards-grid">
        {{#cards}}
        <div class="demo-modal-card-wrapper">
            <div class="demo-modal-card-item">
                <a href="{{url}}" class="demo-modal-card-link"></a>
                <div class="demo-modal-card">
                    <div class="demo-modal-card-img-wrapper">
                        <img src="{{image}}" alt="{{name}}" loading="lazy">
                        <div class="demo-modal-card-img-overlay">
                            <span class="btn-preview">Preview</span>
                        </div>
                    </div>
                    <div class="demo-modal-card-footer">
                        <a href="{{url}}" class="demo-modal-card-name">{{name}}</a>
                    </div>
                </div>
            </div>
        </div>
        {{/cards}}
    </div>
</div>
{{/sections}}
