<div class="whatsapp-settings-tabs">
    <ul class="nav nav-tabs" role="tablist">
        {{#tabs}}
            <li class="nav-item ">
                <a class="nav-link ws-tab {{customclass}} {{#active}}active{{/active}}" data-toggle="tab" href="#{{name}}" role="tab">{{displayname}}</a>
            </li>
        {{/tabs}}
    </ul>
    <div class="tab-content mt-3">
        {{#tabs}}
            <div class="tab-pane {{#active}}active{{/active}}" id="{{name}}" role="tabpanel">
                {{{html}}}
            </div>
        {{/tabs}}
    </div>
</div>